#!/bin/sh
# pre-push: never push to main (claude.md section 4, architecture 9.7, NFR-10).
# Git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Installed by `npm run hooks:install` (core.hooksPath = scripts/hooks).
# This is a compensating control: GitHub Free private repos have no branch protection.

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "pre-push: refusing to push to '${remote_ref#refs/heads/}'." >&2
      echo "Work on a feat/... or fix/... branch and open a pull request." >&2
      exit 1
      ;;
  esac
done

exit 0
